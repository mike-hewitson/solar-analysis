[Unit]
Description=Solar monthly usage projection email
Wants=network-online.target
After=network-online.target postgresql.service solar-analysis.service

[Service]
Type=oneshot
User=piholeadmin
Group=piholeadmin
WorkingDirectory=/home/piholeadmin/solar-health-check
ExecStart=/home/piholeadmin/solar-health-check/.venv/bin/python /home/piholeadmin/solar-health-check/run_solar_usage_projection_email.py
